// Writes src/dct-table.ts from the reference build's own DCT matrix.
//
// Usage: node tools/generate-dct-table.mts <path to reference-dct-table binary>
import { execFileSync } from 'node:child_process';
import { readFileSync, writeFileSync } from 'node:fs';
import { dirname, join, resolve } from 'node:path';
import { fileURLToPath } from 'node:url';

const ROOT = resolve(dirname(fileURLToPath(import.meta.url)), '..');
const ROWS = 16;
const COLS = 64;
const PER_LINE = 8;

function main(): void {
  const driver = process.argv[2];
  if (driver === undefined) {
    throw new Error('usage: generate-dct-table.mts <path to reference-dct-table binary>');
  }
  const words = execFileSync(resolve(driver), { encoding: 'utf8' }).trim().split('\n');
  if (words.length !== ROWS * COLS || words.some((word) => !/^[0-9a-f]{8}$/.test(word))) {
    throw new Error(`expected ${ROWS * COLS} eight-digit hex words from the driver`);
  }
  const notice = readFileSync(join(ROOT, 'NOTICE'), 'utf8');
  const commit = /^PROVENANCE: facebook\/ThreatExchange at ([0-9a-f]{40}) /m.exec(notice)?.[1];
  if (commit === undefined) {
    throw new Error('NOTICE has no PROVENANCE line naming a 40-digit commit');
  }
  const lines: string[] = [];
  for (let i = 0; i < words.length; i += PER_LINE) {
    const row = words.slice(i, i + PER_LINE).map((word) => `0x${word}`);
    lines.push(`  ${row.join(', ')},`);
  }
  const text = [
    '// GENERATED by tools/generate-dct-table.mts. Do not edit by hand.',
    '//',
    `// The ${ROWS} x ${COLS} DCT matrix of the reference (facebook/ThreatExchange, pdq/cpp,`,
    `// commit ${commit}), row-major, each entry the bit`,
    '// pattern of the float32 the reference holds. test/dct-table.test.ts and',
    '// test/reference/dct-table.ref.ts check it.',
    '',
    `export const DCT_ROWS = ${ROWS};`,
    `export const DCT_COLS = ${COLS};`,
    '',
    'export const DCT_MATRIX_BITS: readonly number[] = [',
    ...lines,
    '];',
    '',
  ].join('\n');
  writeFileSync(join(ROOT, 'src', 'dct-table.ts'), text);
  console.log(`wrote src/dct-table.ts (${words.length} entries)`);
}

main();
